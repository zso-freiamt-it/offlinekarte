{
    "options": {
        "paths": {
            "fonts": "klokantech-gl-fonts",
			"sprites": "./osm-style"
        },
        "formatQuality": {
            "jpeg": 80,
            "webp": 90
        },
        "maxScaleFactor": 3,
        "maxSize": 2048,
        "pbfAlias": "pbf",
        "serveAllFonts": true,
        "serveAllStyles": false,
        "serveStaticMaps": true,
        "tileMargin": 5
    },
    "styles": {
        "osm-bright": {
            "style": "./osm-style/style.json"
        }
    },
    "data": {
        "switzerland" : {
            "mbtiles": "tiles.mbtiles"
        }
    }

}

